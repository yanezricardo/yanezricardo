---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { siteConfig } from '../config';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	type?: 'website' | 'article';
}

const {
	title,
	description = siteConfig.description,
	canonicalPath = Astro.url.pathname,
	type = 'website',
} = Astro.props;
const pageTitle = title
	? `${title} — ${siteConfig.name}`
	: `${siteConfig.name} — Software Architect`;
const canonicalUrl = new URL(canonicalPath, siteConfig.url);
const socialImageUrl = new URL('/og.png', siteConfig.url);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#101417" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#f6f3ed" media="(prefers-color-scheme: light)" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content={siteConfig.name} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${siteConfig.name} — ${siteConfig.title}`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<Header />
		<main id="main-content">
			<slot />
		</main>
		<Footer />
	</body>
</html>
