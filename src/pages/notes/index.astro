---
import { getCollection } from 'astro:content';
import NoteCard from '../../components/NoteCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
	(a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
---

<BaseLayout
	title="Notes"
	description="Occasional notes on architecture decisions, technical experiments, and engineering lessons."
>
	<section class="page-section">
		<div class="container">
			<p class="eyebrow">Notes</p>
			<h1>Notes from the work.</h1>
			<p class="lede">
				I am not trying to publish on a schedule. This is where I will keep the occasional
				architecture decision, technical finding, benchmark, or public ADR.
			</p>
		</div>
	</section>

	<section class="page-section" aria-labelledby="notes-title">
		<div class="container">
			<h2 id="notes-title">Published notes</h2>
			{
				notes.length > 0 ? (
					<div class="grid">
						{notes.map((entry) => (
							<NoteCard entry={entry} />
						))}
					</div>
				) : (
					<p class="empty-state">No notes yet.</p>
				)
			}
		</div>
	</section>
</BaseLayout>

<style>
	h1 {
		max-width: 15ch;
	}

	.empty-state {
		max-width: 42rem;
		margin-top: 2.5rem;
		padding: 1.5rem;
		border-left: 3px solid var(--accent);
		background: var(--surface);
		color: var(--muted);
	}
</style>
