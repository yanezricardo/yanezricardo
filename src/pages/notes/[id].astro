---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import TagList from '../../components/TagList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const entries = await getCollection('notes', ({ data }) => !data.draft);

	return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
	entry: CollectionEntry<'notes'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.description}
	canonicalPath={`/notes/${entry.id}/`}
	type="article"
>
	<article>
		<header class="page-section note-header">
			<div class="container">
				<a class="back-link" href="/notes/">← All notes</a>
				<p class="eyebrow">Note</p>
				<h1>{entry.data.title}</h1>
				<p class="lede">{entry.data.description}</p>
				{
					entry.data.date && (
						<time datetime={entry.data.date.toISOString()}>
							{entry.data.date.toLocaleDateString('en')}
						</time>
					)
				}
				<TagList tags={entry.data.tags} />
			</div>
		</header>
		<div class="page-section">
			<div class="container content">
				<Content />
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	.note-header h1 {
		max-width: 14ch;
	}

	.note-header time,
	.note-header .tag-list {
		display: block;
		margin-top: 2rem;
		color: var(--muted);
	}

	.back-link {
		display: inline-block;
		margin-bottom: 3rem;
		color: var(--muted);
		font-size: 0.9rem;
	}
</style>
