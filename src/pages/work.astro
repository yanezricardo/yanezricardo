---
import BaseLayout from '../layouts/BaseLayout.astro';

const areas = [
	{
		title: 'Architecture & Technical Direction',
		description:
			'I define boundaries and contracts, then stay involved when implementation puts those decisions under pressure.',
	},
	{
		title: 'Backend Systems',
		description:
			'Most of the code I write is C# around business workflows, APIs, persistence, and integrations.',
	},
	{
		title: 'Distributed Systems & Integration',
		description:
			'I work on queues, contracts, retries, ownership, and the awkward edges where systems fail independently.',
	},
	{
		title: 'Cloud Delivery & Production',
		description:
			'AWS, containers, infrastructure as code, delivery pipelines, and diagnosing what actually happened in production.',
	},
	{
		title: 'Identity & Access',
		description:
			'Authentication, authorization, sessions, SSO, and deciding which component is allowed to trust which identity.',
	},
	{
		title: 'Applied AI',
		description:
			'I use models where they add value, while keeping validation, confidentiality, cost, and business effects outside them.',
	},
];
---

<BaseLayout
	title="Work"
	description="The engineering domains in which Ricardo Yanez designs systems, writes code, and leads delivery."
>
	<section class="page-section">
		<div class="container">
			<p class="eyebrow">Work</p>
			<h1>Where I usually get involved.</h1>
			<p class="lede">
				I do not separate architecture from delivery. These are the areas where I usually move
				between design, implementation, review, and production diagnosis.
			</p>
		</div>
	</section>

	<section class="page-section" aria-labelledby="areas-title">
		<div class="container">
			<h2 id="areas-title">The recurring parts of the job</h2>
			<div class="areas">
				{
					areas.map(({ title, description }) => (
						<article>
							<h3>{title}</h3>
							<p>{description}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="page-section" aria-labelledby="principle-title">
		<div class="container principle">
			<p class="eyebrow">Working principle</p>
			<h2 id="principle-title">
				I prefer the smallest design that protects the business and leaves the next change
				understandable.
			</h2>
			<a class="text-link" href="/case-studies/">See the case study structure</a>
		</div>
	</section>
</BaseLayout>

<style>
	h1 {
		max-width: 15ch;
	}

	.areas {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		margin-top: 3rem;
		border-top: 1px solid var(--line);
		border-left: 1px solid var(--line);
	}

	.areas article {
		min-height: 12rem;
		padding: 1.5rem;
		border-right: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.areas h3 {
		margin-top: 0;
	}

	.areas article > p:last-child {
		max-width: 31rem;
		margin-top: 0.75rem;
		color: var(--muted);
	}

	.principle h2 {
		max-width: 19ch;
	}

	.principle .text-link {
		margin-top: 2rem;
	}

	@media (max-width: 40rem) {
		.areas {
			grid-template-columns: 1fr;
		}

		.areas article {
			min-height: auto;
		}
	}
</style>
