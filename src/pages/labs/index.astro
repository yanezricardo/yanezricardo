---
import { getCollection } from 'astro:content';
import LabCard from '../../components/LabCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const labs = (await getCollection('labs', ({ data }) => !data.draft)).sort(
	(a, b) => Number(b.data.featured) - Number(a.data.featured),
);
---

<BaseLayout
	title="Labs"
	description="Open-source software and experiments maintained by Ricardo Yanez."
>
	<section class="page-section">
		<div class="container">
			<p class="eyebrow">Labs</p>
			<h1>Software I maintain in public.</h1>
			<p class="lede">
				Open-source libraries, small tools, and experiments. Each entry links to something you can
				use or inspect.
			</p>
		</div>
	</section>

	<section class="page-section" aria-labelledby="projects-title">
		<div class="container">
			<h2 id="projects-title">Projects</h2>
			<div class="grid">
				{labs.map((entry) => <LabCard entry={entry} />)}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	h1 {
		max-width: 14ch;
	}
</style>
