---
import { getCollection } from 'astro:content';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const caseStudies = (
	await getCollection('caseStudies', ({ data }) => data.status === 'published')
).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
---

<BaseLayout
	title="Case studies"
	description="Anonymized engineering case studies focused on context, constraints, decisions, and lessons learned."
>
	<section class="page-section">
		<div class="container">
			<p class="eyebrow">Case studies</p>
			<h1>Why I chose one design over another.</h1>
			<p class="lede">
				These are projects where the difficult part was deciding where work should run, what the
				application should trust, and how the system should fail. Company names and sensitive
				operational details are omitted.
			</p>
		</div>
	</section>

	<section class="page-section" aria-labelledby="cases-title">
		<div class="container">
			<h2 id="cases-title">Selected work</h2>
			<div class="grid">
				{caseStudies.map((entry) => <CaseStudyCard entry={entry} />)}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	h1 {
		max-width: 14ch;
	}
</style>
