---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';

interface Props {
	entry: CollectionEntry<'labs'>;
}

const { entry } = Astro.props;
---

<article class="card">
	<p class="card-meta">{entry.data.status}</p>
	<h3>{entry.data.title}</h3>
	<p>{entry.data.description}</p>
	<TagList tags={entry.data.technologies} />
	<div class="card-links">
		{
			entry.data.url && (
				<a class="text-link" href={entry.data.url}>
					Visit project
				</a>
			)
		}
		{
			entry.data.repository && (
				<a class="text-link" href={entry.data.repository}>
					Repository
				</a>
			)
		}
	</div>
</article>

<style>
	.card-meta {
		color: var(--accent) !important;
		font-family: 'SFMono-Regular', Consolas, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.card-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: auto;
	}
</style>
